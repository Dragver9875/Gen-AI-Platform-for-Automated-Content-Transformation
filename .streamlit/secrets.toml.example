# If Streamlit is later used as the frontend, mirror deployment secrets here.
# Never commit a real token file.
HF_TOKEN = "hf_..."
CHROMA_API_KEY = "..."
CHROMA_TENANT = "..."
CHROMA_DATABASE = "..."
CHROMA_COLLECTION = "document_chunks"

# Harrier uses HF_TOKEN by default; only set these to override.
HARRIER_MODEL = "microsoft/harrier-oss-v1-0.6b"
HARRIER_API_URL = ""
HARRIER_API_KEY = ""

DOCLING_API_URL = "..."
DOCLING_API_KEY = "..."
SIGLIP_API_URL = "..."
SIGLIP_API_KEY = ""
VLM_API_URL = "..."
VLM_API_KEY = ""

# Qwen can use the same HF_TOKEN through the HF OpenAI-compatible router.
LLM_API_URL = ""
LLM_API_KEY = ""
LLM_MODEL = "Qwen/Qwen3-30B-A3B-Instruct-2507"
