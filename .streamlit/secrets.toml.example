# If Streamlit is later used as the frontend, mirror deployment secrets here.
# Never commit a real token file.
HF_TOKEN = "hf_..."

# Chroma Cloud remains an independent credential.
CHROMA_API_KEY = "..."
CHROMA_TENANT = "..."
CHROMA_DATABASE = "..."
CHROMA_COLLECTION = "document_chunks"

# PostgreSQL remains the only other distinct credential for persistent sessions.
SESSION_DATABASE_URL = "postgresql://user:password@host:5432/database"

# All ML endpoints below reuse HF_TOKEN.
HARRIER_MODEL = "microsoft/harrier-oss-v1-0.6b"
HARRIER_API_URL = ""

DOCLING_MODEL = "ibm-granite/granite-docling-258M"
DOCLING_API_URL = ""

SIGLIP_MODEL = "google/siglip-so400m-patch14-384"
SIGLIP_API_URL = ""
VLM_MODEL = "Qwen/Qwen2.5-VL-3B-Instruct"
VLM_API_URL = ""
VLM_API_STYLE = "openai"

RERANKER_MODEL = "BAAI/bge-reranker-v2-m3"
RERANKER_API_URL = ""

# Qwen generation + verification through the HF OpenAI-compatible router.
LLM_API_URL = ""
LLM_MODEL = "openai/gpt-oss-20b:fastest"
LLM_RESPONSE_MODE = "json_schema"
VERIFIER_API_URL = ""
VERIFIER_MODEL = ""
