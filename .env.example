# -------------------------------
# Phase 1: retrieval/indexing
# -------------------------------
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant
CHROMA_DATABASE=your_chroma_database
CHROMA_COLLECTION=document_chunks

# Dedicated hosted Microsoft Harrier endpoint.
# HARRIER_API_STYLE: hf for {"inputs": [...]}; openai for {"input": [...]}
HARRIER_API_URL=https://your-harrier-endpoint.example
HARRIER_API_KEY=your_hf_or_endpoint_token
HARRIER_API_STYLE=hf
HARRIER_BATCH_SIZE=64
HARRIER_QUERY_INSTRUCTION=Retrieve passages from the supplied documents that answer the user's query:

# Optional hosted reranker. Leave empty to use RRF only.
RERANKER_API_URL=
RERANKER_API_KEY=

# -------------------------------
# Phase 2: multimodal ingestion
# -------------------------------
# Docling Serve / Docling for IBM watsonx-compatible base URL.
# Code calls POST {DOCLING_API_URL}/v1/convert/file.
DOCLING_API_URL=https://your-docling-service.example
DOCLING_API_KEY=your_docling_key
DOCLING_TIMEOUT_S=180

# Hosted SigLIP custom endpoint for zero-shot routing.
SIGLIP_API_URL=https://your-siglip-endpoint.example
SIGLIP_API_KEY=your_hf_or_endpoint_token

# Hosted VLM endpoint used for natural images and PDF visual fallback.
VLM_API_URL=https://your-vlm-endpoint.example
VLM_API_KEY=your_hf_or_endpoint_token

# PDF adaptive routing
PDF_NATIVE_TEXT_CHARS=80
PDF_IMAGE_COVERAGE_THRESHOLD=0.72
PDF_VISUAL_FALLBACK_ENABLED=true
PDF_VISUAL_FALLBACK_MAX_PAGES=12

# Chunking
CHUNK_TARGET_CHARS=3200
CHUNK_OVERLAP_CHARS=450

# HTTP
HTTP_TIMEOUT_S=90
HTTP_RETRIES=2
