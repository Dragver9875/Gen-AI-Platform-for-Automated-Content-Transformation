# ============================================================
# Shared Hugging Face credential
# ============================================================
# Create one token at https://huggingface.co/settings/tokens with
# Inference Providers permission. The application reuses HF_TOKEN only for
# Hugging Face-owned URLs (router.huggingface.co / *.huggingface.cloud).
HF_TOKEN=hf_your_token_here

# -------------------------------
# Phase 1: retrieval/indexing
# -------------------------------
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant
CHROMA_DATABASE=your_chroma_database
CHROMA_COLLECTION=document_chunks

# Microsoft Harrier via Hugging Face serverless feature-extraction.
# With HF_TOKEN set, HARRIER_API_URL can normally be omitted.
HARRIER_MODEL=microsoft/harrier-oss-v1-0.6b
HARRIER_API_URL=
HARRIER_API_STYLE=hf
HARRIER_PROMPT_NAME=web_search_query
HARRIER_NORMALIZE=true
HARRIER_BATCH_SIZE=64
# Fallback instruction for non-HF embedding endpoints that do not support prompt_name.
HARRIER_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Optional Hugging Face reranker. RRF remains the fallback when no endpoint is set.
# Recommended model for a HF TEI Inference Endpoint: BAAI/bge-reranker-v2-m3
# The endpoint authenticates with HF_TOKEN; no separate reranker credential is needed.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_URL=
RERANKER_API_STYLE=hf_tei

# -------------------------------
# User/session persistence
# -------------------------------
# memory = development/single-process only; postgres = recommended for deployment
SESSION_STORE_BACKEND=postgres
SESSION_DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_TABLE=user_sessions

# -------------------------------
# Phase 2: multimodal ingestion
# -------------------------------
# Granite Docling via Hugging Face. No separate Docling credential is needed.
# The default is the Hugging Face OpenAI-compatible multimodal router.
# If the model is not available from a serverless provider, point DOCLING_API_URL
# at a Hugging Face Inference Endpoint serving the same model; HF_TOKEN still authenticates it.
DOCLING_MODEL=ibm-granite/granite-docling-258M
DOCLING_API_URL=
DOCLING_TIMEOUT_S=180
DOCLING_RENDER_DPI=144

# Hosted SigLIP custom endpoint for zero-shot routing.
# This must be a Hugging Face endpoint/router URL; HF_TOKEN is reused automatically.
SIGLIP_API_URL=https://your-siglip-endpoint.endpoints.huggingface.cloud

# Hosted VLM endpoint used for natural images and PDF visual fallback.
# This must be a Hugging Face endpoint/router URL; HF_TOKEN is reused automatically.
VLM_API_URL=https://your-vlm-endpoint.endpoints.huggingface.cloud

# PDF adaptive routing
PDF_NATIVE_TEXT_CHARS=80
PDF_IMAGE_COVERAGE_THRESHOLD=0.72
PDF_VISUAL_FALLBACK_ENABLED=true
PDF_VISUAL_FALLBACK_MAX_PAGES=12
SIGLIP_DOCUMENT_LABELS=document page,screenshot
PDF_VISUAL_PROMPT=Describe this PDF page faithfully for retrieval. Preserve all visible text, labels, numbers, chart trends, diagram relationships, and important visual content. If it is primarily a scanned text page, transcribe the meaningful content.

# Chunking
CHUNK_TARGET_CHARS=3200
CHUNK_OVERLAP_CHARS=450

# HTTP
HTTP_TIMEOUT_S=90
HTTP_RETRIES=2

# -------------------------------
# Phase 3: LangGraph orchestration
# -------------------------------
PHASE3_DEFAULT_TOP_K=5
PHASE3_CONTEXT_MAX_CHARS=60000

# -------------------------------
# Phase 4: hosted open-source LLM + Canonical Response Representation
# -------------------------------
# With HF_TOKEN set, leaving LLM_API_URL empty defaults to
# Hugging Face's OpenAI-compatible Inference Providers router:
#   https://router.huggingface.co/v1/chat/completions
# A dedicated endpoint can still be supplied here as an override.
LLM_API_URL=
LLM_API_KEY=
LLM_API_STYLE=openai
LLM_MODEL=openai/gpt-oss-20b:fastest
LLM_RESPONSE_MODE=json_schema
PHASE4_TEMPERATURE=0.1
PHASE4_MAX_TOKENS=4096
PHASE4_GROUP_CONTEXT_MAX_CHARS=18000
PHASE4_DIGEST_MAX_TOKENS=2048

# -------------------------------
# Phase 5: factuality verification + bounded repair
# -------------------------------
# Leave VERIFIER_API_URL empty to reuse the main HF-hosted Qwen endpoint.
# A separate Hugging Face verifier endpoint/model can be supplied without a new credential.
VERIFIER_API_URL=
VERIFIER_API_STYLE=openai
VERIFIER_MODEL=
VERIFIER_RESPONSE_MODE=json_object
PHASE5_VERIFICATION_TEMPERATURE=0.0
PHASE5_VERIFICATION_MAX_TOKENS=4096
PHASE5_REPAIR_TEMPERATURE=0.05
PHASE5_REPAIR_MAX_TOKENS=4096
PHASE5_MAX_REPAIR_ATTEMPTS=2
PHASE5_MIN_FAITHFULNESS_SCORE=1.0
PHASE5_MAX_CLAIMS_PER_CALL=12
PHASE5_EVIDENCE_CHARS_PER_CLAIM=8000

# -------------------------------
# Generic retrieval configuration
# -------------------------------
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_BM25_K=15
RETRIEVAL_VECTOR_K=15
RETRIEVAL_RRF_K=60
RETRIEVAL_USE_RERANKER=true

# -------------------------------
# Generic verification profiles
# -------------------------------
PHASE5_DEFAULT_VERIFICATION_PROFILE=strict
PHASE5_VERIFICATION_PROFILES_JSON=

# -------------------------------
# Phase 6: model-driven artifact decoding
# -------------------------------
PHASE6_OUTPUT_DIR=artifacts
PHASE6_ARTIFACT_SPECS_PATH=artifacts/specs/default.json
PHASE6_TYPST_BINARY=typst
PHASE6_RETAIN_TYPST_SOURCE=true
PHASE6_FAIL_FAST=false
PHASE6_TEMPERATURE=0.1
PHASE6_MAX_TOKENS=4096

# Optional hosted creative-image model endpoint (e.g. hosted FLUX).
# IMAGE_GEN_API_URL should be a Hugging Face URL and reuses HF_TOKEN.
IMAGE_GEN_API_URL=
IMAGE_GEN_API_STYLE=hf
IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-schnell
