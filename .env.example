# ============================================================
# Shared Hugging Face credential
# ============================================================
# One HF token covers Qwen2.5-VL, Harrier, gpt-oss-20b and FLUX.
HF_TOKEN=hf_your_token_here

# -------------------------------
# Chroma Cloud
# -------------------------------
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant
CHROMA_DATABASE=your_chroma_database
CHROMA_COLLECTION=document_chunks

# -------------------------------
# Shared multimodal encoder
# -------------------------------
# TXT/MD stay direct. Every image, PDF page and PPTX slide goes through this model.
QWEN_VL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct:featherless-ai
QWEN_VL_API_URL=
QWEN_VL_API_STYLE=openai
QWEN_VL_MAX_TOKENS=2400
# Bound base64 request size sent to hosted VLM gateways. A 413 triggers one
# automatic retry using the smaller retry budget.
QWEN_VL_MAX_IMAGE_SIDE=1800
QWEN_VL_MAX_IMAGE_BYTES=1200000
QWEN_VL_JPEG_QUALITY=82
QWEN_VL_RETRY_IMAGE_SIDE=1280
QWEN_VL_RETRY_IMAGE_BYTES=650000
QWEN_VL_RETRY_JPEG_QUALITY=68
MULTIMODAL_RENDER_DPI=144
# 0 = unlimited. Keep finite defaults for a hackathon GUI to avoid accidental huge jobs.
MULTIMODAL_MAX_PDF_PAGES=40
MULTIMODAL_MAX_PPTX_SLIDES=40
MULTIMODAL_DOCUMENT_PROMPT=You are the shared multimodal document encoder for a retrieval system. Read this page or slide faithfully and return retrieval-ready Markdown. Preserve headings, paragraphs, lists, tables, equations, labels, numbers, chart values and trends, diagram relationships, captions, and reading order. Describe meaningful non-text visuals. Do not summarize, omit facts, or invent content.
MULTIMODAL_IMAGE_PROMPT=You are the shared multimodal encoder for a retrieval system. Understand this image faithfully and return retrieval-ready Markdown. Preserve all visible text, entities, numbers, labels, spatial or causal relationships, chart or diagram semantics, and other information needed to answer questions about the image. If the image is a photographed or scanned document page, transcribe it rather than merely describing it. Do not invent details.

# -------------------------------
# Harrier embeddings
# -------------------------------
HARRIER_MODEL=microsoft/harrier-oss-v1-0.6b
HARRIER_API_URL=
HARRIER_API_STYLE=hf
HARRIER_PROMPT_NAME=web_search_query
HARRIER_NORMALIZE=true
HARRIER_BATCH_SIZE=64
HARRIER_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Optional HF-compatible reranker. Leave empty to use BM25 + Harrier + RRF.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_URL=
RERANKER_API_STYLE=hf_tei
RETRIEVAL_USE_RERANKER=false

# -------------------------------
# User/session persistence
# -------------------------------
SESSION_STORE_BACKEND=memory
SESSION_DATABASE_URL=
SESSION_TABLE=user_sessions

# -------------------------------
# Chunking + retrieval
# -------------------------------
CHUNK_TARGET_CHARS=3200
CHUNK_OVERLAP_CHARS=450
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_BM25_K=15
RETRIEVAL_VECTOR_K=15
RETRIEVAL_RRF_K=60
PHASE3_DEFAULT_TOP_K=5
PHASE3_CONTEXT_MAX_CHARS=60000

# -------------------------------
# Main semantic decoder: generation + verification + repair
# -------------------------------
LLM_API_URL=
LLM_API_STYLE=openai
LLM_MODEL=openai/gpt-oss-20b:fastest
LLM_RESPONSE_MODE=json_schema
PHASE4_TEMPERATURE=0.1
PHASE4_MAX_TOKENS=4096
PHASE4_GROUP_CONTEXT_MAX_CHARS=18000
PHASE4_DIGEST_MAX_TOKENS=2048

# Phase 5 uses the SAME gpt-oss-20b provider; there is no separate verifier model.
PHASE5_VERIFICATION_TEMPERATURE=0.0
PHASE5_VERIFICATION_MAX_TOKENS=4096
PHASE5_REPAIR_TEMPERATURE=0.05
PHASE5_REPAIR_MAX_TOKENS=4096
PHASE5_MAX_REPAIR_ATTEMPTS=2
PHASE5_MIN_FAITHFULNESS_SCORE=1.0
PHASE5_MAX_CLAIMS_PER_CALL=12
PHASE5_EVIDENCE_CHARS_PER_CLAIM=8000
PHASE5_DEFAULT_VERIFICATION_PROFILE=strict
PHASE5_VERIFICATION_PROFILES_JSON=

# -------------------------------
# Artifact decoding
# -------------------------------
PHASE6_OUTPUT_DIR=runtime_artifacts
PHASE6_ARTIFACT_SPECS_PATH=artifacts/specs/default.json
PHASE6_TYPST_BINARY=typst
PHASE6_RETAIN_TYPST_SOURCE=true
PHASE6_FAIL_FAST=false
PHASE6_TEMPERATURE=0.1
PHASE6_MAX_TOKENS=4096

# Creative image decoder: FLUX through Hugging Face Inference Providers.
# hf_hub uses huggingface_hub.InferenceClient(provider="auto") and HF_TOKEN.
IMAGE_GEN_API_STYLE=hf_hub
IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_GEN_PROVIDER=auto
IMAGE_GEN_API_URL=

# -------------------------------
# HTTP
# -------------------------------
HTTP_TIMEOUT_S=120
HTTP_RETRIES=2

# -------------------------------
# Web chat / Render
# -------------------------------
WEB_MAX_WORKERS=3
WEB_MAX_FILE_MB=40
WEB_MAX_TOTAL_UPLOAD_MB=100
WEB_UPLOAD_DIR=runtime_uploads
